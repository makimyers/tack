@@ -124,6 +124,20 @@ def test_inkling_launcher_and_dsh_route_agree():
     assert core.Status(loaded=m).dsh_port == m.dsh_port == 3081
 
 
+def test_bonsai_launcher_and_dsh_use_the_same_text_model():
+    m = next(x for x in core.models() if x.key == "bonsai")
+    argv = core.build_start_argv(m)
+    assert argv[argv.index("--model") + 1] == m.path
+    assert argv[argv.index("--alias") + 1] == m.model_id
+    assert argv[argv.index("--ctx-size") + 1] == str(m.ctx)
+    assert argv[argv.index("--spec-type") + 1] == "draft-mtp"
+    overlay = core.overlay_text(m)
+    assert f"      {m.provider}:\n" in overlay
+    assert f"          - id: {m.model_id}\n" in overlay
+    assert f"        defaultContextWindow: {m.ctx}\n" in overlay
+    assert "            input: [text]\n" in overlay
+
+
